# DWARIX Technologies - Node.js Express Server Environment Configuration (Template)
# Copy this file to .env and fill in your environment-specific credentials.

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (MongoDB Atlas)
# Replace with your cluster connection URI. Percent-encode special characters in password (e.g., '@' -> '%40').
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/dwarix_db?retryWrites=true&w=majority

# Local / Testing Database Flags (Only allowed in development/testing, never in production)
ALLOW_IN_MEMORY_DB=false
USE_IN_MEMORY_DB=false

# Authentication & Security
# Generate a cryptographically random 64-character hex string for JWT signing
JWT_SECRET=your_jwt_secret_min_64_hex_characters_here
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (Used during deployment setup script)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here
INITIAL_ADMIN_NAME=DWARIX Administrator

# Nodemailer SMTP Configuration (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_application_password
EMAIL_FROM="DWARIX Technologies" <no-reply@example.com>
ADMIN_NOTIFY_EMAIL=admin@example.com

# Cloudinary Image Hosting (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
