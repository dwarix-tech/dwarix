{
  "name": "dwarix-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node -e \"console.log('Run npm run dev:server and npm run dev:client')\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && node -e \"require('fs').cpSync('client/dist', 'dist', {recursive: true})\"",
    "start": "npm start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "setup:admin": "npm run setup:admin --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
